---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-8 pb-8">
      <!-- Telemetry Status Bar -->
      <div class="mb-4 flex flex-wrap items-center gap-2 font-mono text-[11px] tracking-wider text-muted-foreground uppercase">
        <span class="inline-flex items-center gap-1.5 border border-border bg-muted/40 px-2.5 py-0.5">
          <span class="size-1.5 rounded-full bg-status-ok shadow-[0_0_6px_var(--color-status-ok)]"></span>
          SYS // CALIBRATED
        </span>
        <span class="border border-border bg-muted/40 px-2.5 py-0.5">
          REGIME: AUTONOMOUS
        </span>
        <span class="hidden border border-border bg-muted/40 px-2.5 py-0.5 sm:inline-block">
          SPEC: 0x4F92-OMEN
        </span>
      </div>

      <div class="flex items-baseline justify-between">
        <div>
          <h1 class="font-mono text-3xl font-extrabold tracking-tight uppercase sm:text-4xl text-foreground">
            The Great Plan
          </h1>
          <p class="font-mono text-xs uppercase tracking-widest text-accent mt-1">
            Ineffable Dynamics // Quantitative Screener Engine
          </p>
        </div>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="border border-border p-2 bg-muted/30 hover:border-accent transition-colors"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss
            width={18}
            height={18}
            class="stroke-accent rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>

      <!-- Blueprint Directive Dossier Box -->
      <div class="relative my-6 border border-border/80 bg-muted/25 p-4 sm:p-5 backdrop-blur-xs">
        <span class="pointer-events-none absolute -top-1.5 -left-1.5 font-mono text-[9px] text-accent/60 select-none">+</span>
        <span class="pointer-events-none absolute -top-1.5 -right-1.5 font-mono text-[9px] text-accent/60 select-none">+</span>
        <span class="pointer-events-none absolute -bottom-1.5 -left-1.5 font-mono text-[9px] text-accent/60 select-none">+</span>
        <span class="pointer-events-none absolute -bottom-1.5 -right-1.5 font-mono text-[9px] text-accent/60 select-none">+</span>

        <div class="mb-2 font-mono text-[10px] tracking-widest text-muted-foreground uppercase flex items-center gap-1.5">
          <span class="size-1 rounded-full bg-accent"></span>
          <span>DIRECTIVE // ARCHIVE RECORD</span>
        </div>
        <blockquote class="font-mono text-xs leading-relaxed text-foreground/90 sm:text-sm">
          "But the Great Plan can only be a tiny part of the overall ineffability... You can’t be certain that what’s happening right now isn’t exactly right, from an ineffable point of view."
        </blockquote>
        <div class="mt-2 text-right font-mono text-[11px] text-accent/80 tracking-wide">
          — Crowley (Good Omens) // PARADOX COMPLIANT
        </div>
      </div>

      <p class="text-sm leading-relaxed text-foreground/90 sm:text-base">
        Welcome to the <strong class="text-foreground font-semibold">BadOmen Trading Journal</strong>. This console aggregates automated execution logs, market regime analyses, forward Wall Street consensus updates, and trade execution sheets generated by the BadOmen tech asset screener. Here, we track high-impact growth, semiconductor, and tech equities to identify value mismatches and pullback opportunities.
      </p>

      <!-- Machinery Subsystem Matrix -->
      <div class="mt-6 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        <div class="border border-border/70 bg-muted/20 p-2.5 font-mono text-xs">
          <span class="text-accent font-semibold text-[10px] tracking-wider block">01 // REGIME ENGINE</span>
          <span class="text-muted-foreground text-[11px]">SPY 200-SMA Dynamic Switching</span>
        </div>
        <div class="border border-border/70 bg-muted/20 p-2.5 font-mono text-xs">
          <span class="text-accent font-semibold text-[10px] tracking-wider block">02 // TARGET SPACE</span>
          <span class="text-muted-foreground text-[11px]">Liquid Semis & Growth Equities</span>
        </div>
        <div class="border border-border/70 bg-muted/20 p-2.5 font-mono text-xs">
          <span class="text-accent font-semibold text-[10px] tracking-wider block">03 // ENTRY LOGIC</span>
          <span class="text-muted-foreground text-[11px]">Beta-Adjusted Pullback Orders</span>
        </div>
        <div class="border border-border/70 bg-muted/20 p-2.5 font-mono text-xs">
          <span class="text-accent font-semibold text-[10px] tracking-wider block">04 // RISK SHIELD</span>
          <span class="text-muted-foreground text-[11px]">Multi-Tiered Algorithmic Exits</span>
        </div>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-3 text-xs font-mono">
        <span class="text-muted-foreground">DOCUMENTATION:</span>
        <LinkButton
          class="border border-border bg-muted/40 px-2.5 py-1 text-accent hover:border-accent hover:bg-muted/60 transition-colors"
          href="https://github.com/cevangelio/BadOmen"
        >
          [→] BadOmen Repository
        </LinkButton>
      </div>

      {
        socials.length > 0 && (
          <div class="mt-6 flex max-sm:flex-col sm:items-center border-t border-border/60 pt-4 font-mono text-xs text-muted-foreground">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0 uppercase tracking-wider">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-10 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <div class="mb-4 flex items-center justify-between border-b border-border/70 pb-2 font-mono">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground flex items-center gap-2">
              <span class="text-accent">//</span>
              <span>{t.home.featured}</span>
              <span class="text-[10px] text-muted-foreground/60">[LOGS.PRIORITY]</span>
            </h2>
            <span class="text-[10px] text-muted-foreground/60">SEC.01</span>
          </div>
          <ul class="space-y-3">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-10 pb-6">
          <div class="mb-4 flex items-center justify-between border-b border-border/70 pb-2 font-mono">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground flex items-center gap-2">
              <span class="text-accent">//</span>
              <span>{t.home.recentPosts}</span>
              <span class="text-[10px] text-muted-foreground/60">[TELEMETRY.CHRONOLOGICAL]</span>
            </h2>
            <span class="text-[10px] text-muted-foreground/60">SEC.02</span>
          </div>
          <ul class="space-y-3">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="inline-flex items-center gap-2 border border-border bg-muted/30 px-5 py-2.5 font-mono text-xs uppercase tracking-widest text-foreground hover:border-accent hover:text-accent transition-all"
      >
        <span>{t.home.allPosts}</span>
        <IconArrowRight class="inline-block size-3.5 rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
