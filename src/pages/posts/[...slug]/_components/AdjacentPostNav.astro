---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<div data-pagefind-ignore class="my-8 grid grid-cols-1 gap-4 sm:grid-cols-2 font-mono">
  {
    prevPost && (
      <a
        href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
        class="border border-border/70 bg-muted/20 p-3.5 hover:border-accent/70 hover:bg-muted/40 transition-all flex items-start gap-2.5 text-xs"
      >
        <IconArrowLeft class="size-4 flex-none text-accent mt-0.5 rtl:rotate-180" />
        <div>
          <span class="text-[10px] uppercase tracking-wider text-muted-foreground block">{t.post.previousPost}</span>
          <div class="text-foreground text-sm font-semibold tracking-tight mt-0.5">{prevPost.title}</div>
        </div>
      </a>
    )
  }
  {
    nextPost && (
      <a
        href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
        class="border border-border/70 bg-muted/20 p-3.5 hover:border-accent/70 hover:bg-muted/40 transition-all flex items-start justify-end text-end gap-2.5 text-xs sm:col-start-2"
      >
        <div>
          <span class="text-[10px] uppercase tracking-wider text-muted-foreground block">{t.post.nextPost}</span>
          <div class="text-foreground text-sm font-semibold tracking-tight mt-0.5">{nextPost.title}</div>
        </div>
        <IconArrowRight class="size-4 flex-none text-accent mt-0.5 rtl:rotate-180" />
      </a>
    )
  }
</div>
