---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "inline-flex items-center gap-1 font-mono tracking-tight",
      "border border-border/80 bg-muted/25 px-2 py-0.5",
      "hover:border-accent/80 hover:text-accent hover:bg-muted/50 transition-all",
      "focus-visible:text-accent focus-visible:border-accent",
      { "text-xs": size === "sm" },
      { "text-sm": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "text-accent/70",
        { "size-3.5": size === "lg" },
        { "size-3": size === "sm" },
      ]}
    />
    <span>{tagName}</span>
  </a>
</li>
