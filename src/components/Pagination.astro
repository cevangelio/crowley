---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";
import { useTranslations } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;

const t = useTranslations(Astro.currentLocale);
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex items-center justify-center gap-3 font-mono text-xs"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class:list={[
          "border border-border/80 bg-muted/25 px-3 py-1.5 uppercase tracking-wider select-none transition-all",
          page.url.prev
            ? "hover:border-accent hover:text-accent"
            : "opacity-40 cursor-not-allowed",
        ]}
        aria-label={t.a11y.goToPreviousPage}
      >
        <IconArrowLeft class="inline-block size-3.5 rtl:rotate-180" />
        {t.pagination.prev}
      </LinkButton>
      <span class="text-muted-foreground px-2">
        PAGE {page.currentPage} // {page.lastPage}
      </span>
      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class:list={[
          "border border-border/80 bg-muted/25 px-3 py-1.5 uppercase tracking-wider select-none transition-all",
          page.url.next
            ? "hover:border-accent hover:text-accent"
            : "opacity-40 cursor-not-allowed",
        ]}
        aria-label={t.a11y.goToNextPage}
      >
        {t.pagination.next}
        <IconArrowRight class="inline-block size-3.5 rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
