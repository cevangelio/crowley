---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
};

const { pageTitle, pageDesc, class: className } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={["app-layout pb-8", className]}
>
  <div class="mb-6 border-b border-border/80 pb-4">
    <div class="font-mono text-[10px] tracking-widest text-accent uppercase mb-1">
      // TELEMETRY RECORD
    </div>
    <h1 class="font-mono text-2xl font-bold uppercase tracking-tight sm:text-3xl">
      {
        Array.isArray(pageTitle) ? (
          <span>
            {pageTitle[0]}
            <span class="text-accent">{pageTitle[1]}</span>
          </span>
        ) : (
          pageTitle
        )
      }
    </h1>
    {pageDesc && (
      <p class="mt-2 font-mono text-xs text-muted-foreground">{pageDesc}</p>
    )}
  </div>
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
